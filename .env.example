# Frontend build/runtime variable used by Vite.
GEMINI_API_KEY=

# Development compose ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional file watching overrides for Docker bind mounts
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# Production compose ports (docker-compose.prod.yml)
FRONTEND_PROD_PORT=8080
BACKEND_PROD_PORT=8000
